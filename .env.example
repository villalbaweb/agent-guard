# --- LLM PROVIDER CONFIGURATION ---

# 1. Anthropic (Precedence 1)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# 2. Vertex AI (Precedence 2)
# Option A: Service Account (Recommended for Server-to-Server)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-file.json

# Option B: Cloud API Key + Project ID (Easiest for credits)
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# 3. Google AI Studio / Gemini (Precedence 3)
# GOOGLE_API_KEY=your_gemini_api_key

# 4. OpenAI (Precedence 4)
# OPENAI_API_KEY=your_openai_api_key

# --- END CONFIGURATION ---
