# =============================================================================
# AgentGuard — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# --- LLM PROVIDER (pick one; resolved in priority order) ---

# 1. Google AI Studio / Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001   # or gemini-embedding-2-preview

# 2. Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 3. OpenAI-compatible — works with OpenAI, OpenRouter, LiteLLM, vLLM, Ollama
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                         # Leave blank for standard OpenAI
#                                           # OpenRouter: https://openrouter.ai/api/v1
#                                           # LiteLLM:    http://localhost:4000
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # Used for semantic loop detection

# 4. Google Vertex AI (service account required)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEX_MODEL=gemini-2.0-flash

# --- INFRASTRUCTURE (docker-compose.poc.yml) ---

REDIS_URL=redis://localhost:6379

# --- POLICY ---

# Path to the YAML policy rules file loaded by PolicyEngine
POLICY_FILE=policy.yaml

# --- REST API (Step B) ---

# Static API key for Phase 1 auth (alternative to JWT)
# AGENTGUARD_API_KEY=your-static-key-here

# CORS origins (comma-separated, * = allow all for dev)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# Set to 1 to disable auth entirely (DEVELOPMENT ONLY — never set in production)
# AGENTGUARD_NO_AUTH=1

# --- JWT AUTH (Step C) ---

# HS256 signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENTGUARD_JWT_SECRET=

# JWT issuer claim (must match between token creation and verification)
AGENTGUARD_JWT_ISSUER=agentguard

# --- POSTGRESQL (Agent Registry — U-09/U-12) ---

# Full DSN for the agentguard backend. Points to the Docker service name in compose.
# DATABASE_URL=postgresql://agent_user:changeme@localhost:5432/agent_db

# Credentials used by the postgres docker-compose service
# POSTGRES_DB=agent_db
# POSTGRES_USER=agent_user
# POSTGRES_PASSWORD=changeme

# Expected embedding dimension — must match your embedding provider:
#   OpenAI text-embedding-3-small  → 1536 (default)
#   Google gemini-embedding-001    → 768
# EMBEDDING_DIM=1536

# --- LANGSMITH TRACING (optional LLM observability) ---
# Get an API key at https://smith.langchain.com — traces every LLM call,
# graph node, and token count. No code changes required.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=agent-guard

# --- LLM PROVIDER SWITCH ---
# Explicitly pick the chat provider (wins even when several API keys are set):
#   google | openrouter | anthropic | openai | vertex
# Leave unset for auto-detect (first configured key wins, Google first).
# LLM_PROVIDER=google

# --- OPENROUTER (multi-model: any slug from https://openrouter.ai/models) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- POLICY GUARD MODEL (optional) ---
# Model for the PolicyEngine's per-step safety check. Uses the provider selected
# above with its credentials, overriding only the model slug. Defaults to the
# same model as the executor. Prefer a fast one: the guard runs on every step,
# answers with a single word, and fails closed if it times out.
# AGENTGUARD_GUARD_MODEL=openai/gpt-4o-mini
